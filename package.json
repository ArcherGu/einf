{
  "name": "einf",
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "description": "A simple electron main process framework",
  "author": "ArcherGu",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/ArcherGu/einf"
  },
  "keywords": [
    "electron",
    "framework",
    "decorator",
    "metadata"
  ],
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm build && vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "electron": ">=16.0.0"
  },
  "dependencies": {
    "colorette": "^2.0.20",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@lightwing/eslint-config": "1.0.160",
    "@types/node": "25.9.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "baseline-browser-mapping": "^2.10.33",
    "electron": "44.2.0",
    "eslint": "10.10.0",
    "execa": "10.0.1",
    "lint-staged": "17.4.1",
    "semantic-release": "25.0.9",
    "simple-git-hooks": "2.14.0",
    "tsdown": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.2",
    "vite-plugin-doubleshot": "0.0.26",
    "vitest": "5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md,json,yml}": [
      "eslint --fix"
    ]
  }
}
